{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/aboutme/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio-data/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio-marketing/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio-web/?$",
			"dest": "_render"
		},
		{
			"src": "^/recent-work/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}