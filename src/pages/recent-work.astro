---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: 'xdo0hyha', // ID Sanity Anda
  dataset: 'production',
  useCdn: true,
  apiVersion: '2024-01-01',
});

// Menarik data khusus dari "recentWork" (semua kategori)
const recentWorkQuery = `*[_type == "recentWork"] | order(_createdAt desc){
  title,
  description,
    "imageUrl": image.asset->url + "?w=1200&q=75&auto=format",
  date,
  category,
  tech,
  status,
  projectUrl,
  buttonText
}`;

// PASTIKAN NAMA VARIABELNYA ADALAH "recentWorks"
const recentWorks = await client.fetch(recentWorkQuery);

// Fungsi pembantu untuk memberi warna berbeda tiap kategori
const getCategoryColor = (category) => {
    if (category === 'Web Dev') return 'bg-neon-cyan text-black';
    if (category === 'Data Analyst') return 'bg-neon-red text-white';
    if (category === 'Digital Marketing') return 'bg-neon-green text-black';
    return 'bg-black text-white'; // Warna default
};
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head> 
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Arsip Proyek - Asyraf">
    <meta name="author" content="asyraf">
    <title>Recent Work Archive - Asyraf</title>
    
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'neon-red': '#FF3333',
                        'neon-green': '#33FF33',
                        'neon-cyan': '#33FFFF',
                        'neon-yellow': '#FFFF33',
                    }
                }
            }
        }
    </script>

    <style is:inline>
        body {
            color: #000000;
            font-family: 'Courier New', Courier, monospace, sans-serif;
            background-color: #F5F5F5;
        }
        .nb-border-heavy { border: 3px solid #000000 !important; }
        .nb-shadow-black { box-shadow: 6px 6px 0px 0px #000000 !important; }
        .nb-btn-click { transition: transform 0.05s ease, box-shadow 0.05s ease; }
        .nb-btn-click:active {
            transform: translate(6px, 6px);
            box-shadow: 0px 0px 0px 0px #000000 !important;
        }
    </style>
</head>
<body class="overflow-x-hidden p-4 md:p-8">

    <Navbar />

    <section id="pageHeader" class="mx-auto max-w-5xl mb-16 pt-28 md:pt-36">
        <div class="bg-neon-yellow p-8 md:p-12 nb-border-heavy nb-shadow-black text-center relative overflow-hidden">
            <i class="fas fa-folder-open absolute -right-10 -bottom-10 text-[200px] text-white opacity-40 -rotate-12"></i>
            <p class="font-black text-lg md:text-xl mb-2 bg-white inline-block px-4 border-2 border-black relative z-10">ARCHIVE</p>
            <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter relative z-10 text-black">Recent Work</h1>
            <p class="font-bold mt-4 max-w-2xl mx-auto text-lg relative z-10 bg-white p-2 border-2 border-black">Dokumentasi rekam jejak pengerjaan proyek, dari yang sedang berjalan hingga yang telah selesai.</p>
        </div>
    </section>

    <section class="mx-auto max-w-5xl mb-24">
        <div class="flex flex-col gap-12">
            
            {recentWorks.map((work) => (
                <div class="w-full bg-white nb-border-heavy nb-shadow-black flex flex-col md:flex-row group">
                    
                    <!-- KIRI: FOTO DENGAN LABEL BENTUK SELOTIP -->
                    <div class="w-full md:w-2/5 relative flex bg-gray-200 border-b-4 md:border-b-0 md:border-r-4 border-black">
                        
                        <div class="w-full h-full overflow-hidden relative">
                            {work.imageUrl ? (
                                <img
                                    src={work.imageUrl}
                                    alt={work.title}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-cover min-h-[250px] md:min-h-full group-hover:scale-105 transition duration-500"
                                    >
                            ) : (
                                <div class="w-full h-full min-h-[250px] flex items-center justify-center text-gray-400">No Image</div>
                            )}
                        </div>
                        
                        <!-- Label Status Bentuk Selotip Sobek (Tidak bergerak saat hover) -->
                        <div class="absolute -top-4 -left-6 z-30 transform -rotate-12 w-36 h-10">
                            
                            <!-- Garis tepi (stroke-width) ditipiskan menjadi 1.5 -->
                            <svg class="absolute inset-0 w-full h-full drop-shadow-[4px_4px_0px_rgba(0,0,0,1)]" preserveAspectRatio="none" viewBox="0 0 120 36">
                                <polygon points="8,2 112,2 118,8 112,14 118,20 112,26 118,34 8,34 2,28 8,22 2,16 8,10 2,2"
                                         class={work.status === 'Completed' ? 'fill-neon-green' : 'fill-neon-yellow'}
                                         stroke="black" stroke-width="1.5" stroke-linejoin="round"/>
                            </svg>
                            
                            <!-- Teks Status di Tengah Selotip -->
                            <div class="relative z-10 flex items-center justify-center w-full h-full font-black text-xs md:text-sm uppercase tracking-wider text-black pointer-events-none">
                                {work.status}
                            </div>
                            
                        </div>
                        
                    </div>
                    
                    <!-- KANAN: RINCIAN PROYEK -->
                    <div class="p-6 md:p-8 w-full md:w-3/5 flex flex-col relative bg-white">
                        
                        <!-- 3. Kategori Dinamis Berwarna & Waktu -->
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class={`border-2 border-black text-xs font-black px-3 py-1 tracking-widest ${getCategoryColor(work.category)}`}>
                                {work.category}
                            </span>
                            <span class="bg-white text-black border-2 border-black text-xs font-black px-3 py-1">
                                {work.date}
                            </span>
                        </div>
                        
                        <!-- Judul -->
                        <h3 class="text-3xl font-black uppercase leading-tight mb-4">{work.title}</h3>
                        
                        <!-- 4. Tag Teknologi Bentuk Kotak Kecil -->
                        <div class="flex flex-wrap gap-2 mb-5">
                            {work.tech && work.tech.split('//').map((tag) => (
                                <span class="bg-gray-100 border-2 border-black px-2 py-1 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000000]">
                                    {tag.trim()}
                                </span>
                            ))}
                        </div>
                        
                        <!-- Deskripsi -->
                        <p class="font-bold text-gray-700 mb-8 flex-grow text-sm md:text-base">
                            {work.description}
                        </p>
                        
                        <!-- 2. Tombol Link Project (Dinamis dari CMS) -->
                        <div class="mt-auto">
                            {work.projectUrl ? (
                                <a href={work.projectUrl} target="_blank" class="inline-block bg-black text-white font-black px-6 py-3 text-sm nb-border-heavy nb-shadow-black nb-btn-click hover:bg-neon-cyan hover:text-black transition-colors uppercase">
                                    <i class="fas fa-external-link-alt mr-2"></i> {work.buttonText || 'LIHAT PROYEK'}
                                </a>
                            ) : (
                                <button class="inline-block bg-gray-300 text-gray-500 font-black px-6 py-3 text-sm nb-border-heavy cursor-not-allowed uppercase">
                                    <i class="fas fa-lock mr-2"></i> PRIVATE PROYEK
                                </button>
                            )}
                        </div>

                    </div>
                </div>
            ))}

        </div>
    </section>

    <Footer />

</body>
</html>